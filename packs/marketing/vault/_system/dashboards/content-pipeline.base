filters:
  and:
    - file.inFolder("work/content")
    - type == "content"
    - status != "archived"
formulas:
  stage_rank: if(stage == "idea", "1 idea", if(stage == "draft", "2 draft", if(stage == "review", "3 review", if(stage == "scheduled", "4 scheduled", "5 published"))))
properties:
  channel:
    displayName: Channel
  publish_date:
    displayName: Publish date
  stage:
    displayName: Stage
  campaign:
    displayName: "{{ct.Workstream}}"
  owner:
    displayName: Owner
  formula.stage_rank:
    displayName: Stage
views:
  - type: table
    name: Content pipeline
    groupBy:
      property: formula.stage_rank
      direction: ASC
    order:
      - file.name
      - channel
      - publish_date
      - campaign
      - owner
    sort:
      - property: publish_date
        direction: ASC
