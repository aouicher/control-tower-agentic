{
  "id": "debt-review",
  "name": "Debt review",
  "description": "Weekly review of code quality and dependency alerts, written into the technical debt area note.",
  "schedule": {
    "days": "fri",
    "time": "10:00"
  },
  "model": "sonnet",
  "capabilities": {
    "required": [
      "quality"
    ],
    "optional": [
      "code"
    ]
